# Copy to .env (git-ignored) and set a password. Local development only.
DB_NAME=property_tax
DB_USERNAME=property_tax
DB_PASSWORD=change-me
DB_PORT=5433

# Local-only stand-in for Amazon Cognito. NEVER set in a deployed environment.
DEV_AUTH=true

# Local S3 emulator (docker compose service `s3`). Leave S3_ENDPOINT unset in AWS to use real Amazon S3.
S3_ENDPOINT=http://localhost:9090
DOCUMENTS_BUCKET=civictax-documents

# Local DynamoDB emulator (docker compose service `dynamodb`). Leave unset in AWS to use real DynamoDB.
DYNAMODB_ENDPOINT=http://localhost:8000

# Local Step Functions emulator (docker compose service `stepfunctions`). Leave unset in AWS.
STEP_FUNCTIONS_ENDPOINT=http://localhost:8083
# Dev mode runs the report worker inside the backend process. In Docker/AWS the worker is its own container.
REPORT_WORKER_ENABLED=true
